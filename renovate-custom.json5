// Repo-specific Renovate rules (renovate.json5 is generated by devctl and
// kept in sync by align-files; this file is appended to its extends).
{
  customManagers: [
    {
      // helm/buzz/ci/quickstart-values.yaml pins the released buzz-minio
      // build for the kind deploy of the chart tests. Only semver release
      // tags are candidates: the dev tags (X.Y.Z-r<hash>t<time>h<sha>) are
      // prereleases, which Renovate skips for a stable pin.
      description: 'buzz-minio quickstart pin: follow the released images',
      customType: 'regex',
      managerFilePatterns: ['/^helm/buzz/ci/quickstart-values\\.yaml$/'],
      matchStrings: ['gsoci\\.azurecr\\.io/giantswarm/buzz-minio:(?<currentValue>\\S+)'],
      depNameTemplate: 'gsoci.azurecr.io/giantswarm/buzz-minio',
      datasourceTemplate: 'docker',
      versioningTemplate: 'semver',
    },
  ],
  packageRules: [
    {
      // vendir.yml vendors the relay chart of block/buzz at its relay-v* tags.
      // The repository also tags Buzz Desktop releases as v*, which are an
      // unrelated, older line: without this rule Renovate reads relay-v0.2.1
      // as 0.2.1 and proposes the desktop v0.5.x tags as updates (buzz#27,
      // a downgrade of the vendored chart by 234 commits).
      description: 'block/buzz: follow the relay-v* tags only',
      matchManagers: ['vendir'],
      matchPackageNames: ['https://github.com/block/buzz'],
      extractVersion: '^relay-v(?<version>.+)$',
      versioning: 'semver',
    },
    {
      // helm/buzz/charts and helm/buzz/templates are vendir's: every vendir
      // bump runs `make sync-chart` (.github/workflows/vendir-sync.yaml),
      // which resets them to the pinned upstream. An image bump inside them
      // would be reverted by the next sync, so they move only with vendir.yml.
      description: 'vendored chart trees: updated through vendir.yml only',
      matchFileNames: ['helm/buzz/charts/**', 'helm/buzz/templates/**'],
      enabled: false,
    },
  ],
}
